{
  "name": "pineboard",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "setup": "node scripts/setup.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "deploy": "pnpm build && wrangler deploy --config wrangler.site.jsonc",
    "db:generate": "pnpm --filter @pineboard/db db:generate",
    "db:migrate": "wrangler d1 migrations apply pineboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply pineboard --remote",
    "typecheck": "pnpm -r typecheck",
    "check:deploy-env": "node scripts/check-deploy-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postbuild": "node scripts/clean-build.mjs",
    "test:e2e:p1": "node scripts/e2e-p1.mjs",
    "test:e2e:p2": "node scripts/e2e-p2.mjs",
    "test:e2e:p3": "node scripts/e2e-p3.mjs",
    "test:e2e:p4": "node scripts/e2e-p4.mjs",
    "test:e2e:p5": "node scripts/e2e-p5.mjs",
    "test:e2e:p6": "node scripts/e2e-p6.mjs",
    "test:p6:build": "node scripts/check-p6-build.mjs",
    "test:e2e:remote": "node scripts/e2e-remote.mjs",
    "backup:order": "node scripts/order-restore.mjs",
    "test:e2e:v2": "node scripts/e2e-v2.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.3"
  }
}
